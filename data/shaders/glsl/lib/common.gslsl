#ifdef GL_ES
precision highp float;
#endif

uniform vec2 iResolution;
uniform float iTime;

// NOISE

float hash1(vec3 p) {
    return fract(sin(dot(p, vec3(127.1,311.7,74.7))) * 43758.5453);
}

float noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    return mix(mix(mix(hash1(i + vec3(0,0,0)), hash1(i + vec3(1,0,0)), f.x),
                   mix(hash1(i + vec3(0,1,0)), hash1(i + vec3(1,1,0)), f.x), f.y),
               mix(mix(hash1(i + vec3(0,0,1)), hash1(i + vec3(1,0,1)), f.x),
                   mix(hash1(i + vec3(0,1,1)), hash1(i + vec3(1,1,1)), f.x), f.y),
               f.z);
}

float fbm(vec3 p) {
    float v = 0.0;
    float a = 0.5;
    for(int i=0;i<5;i++){
        v += noise(p) * a;
        p *= 2.0;
        a *= 0.5;
    }
    return v;
}

// ANIMATION

vec2 rotate2D(vec2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return vec2(c*p.x - s*p.y, s*p.x + c*p.y);
}

vec3 animateGalaxy(vec3 p, float time) {
    float r = length(p.xy);
    float speed = 0.4 / (r + 0.2);
    float angle = time * speed;
    p.xy = rotate2D(p.xy, angle);
    return p;
}

float starTwinkle(float h, float time) {
    return 0.8 + 0.4 * sin(time * 8.0 + h * 100.0);
}

// STARS

vec3 starColor(float t) {
    float temp = mix(2000.0, 12000.0, t);

    vec3 col;
    col.r = 1.0;
    col.g = clamp(1.0 - abs(temp - 6000.0)/6000.0, 0.0, 1.0);
    col.b = clamp((temp - 2000.0)/10000.0, 0.0, 1.0);

    return col;
}

vec3 starField(vec3 p, float time) {

    vec3 col = vec3(0.0);

    vec3 cell = floor(p);
    float h = hash1(cell);

    if(h > 0.996) {
        vec3 local = fract(p) - 0.5;
        float d = length(local);

        float glow = exp(-d * 40.0);
        float brightness = pow(fract(h * 100.0), 5.0);

        brightness *= starTwinkle(h, time);

        float temp = fract(h * 10.0);

        col = starColor(temp) * glow * brightness * 5.0;
    }

    return col;
}

// GALAXY

float galaxyDensity(vec3 p, float time) {

    p = animateGalaxy(p, time);

    float r = length(p.xy);
    float theta = atan(p.y, p.x);

    float arms1 = cos(theta * 3.0 - r * 6.0 + time);
    float arms2 = cos(theta * 5.0 + r * 4.0 - time * 0.5);

    float arms = (arms1 + arms2) * 0.5;

    float n = fbm(p * 2.0 + time);

    float density = smoothstep(0.2, 1.0, arms + n);

    density *= exp(-r * 1.5);
    density *= exp(-abs(p.z) * 4.0);

    return density;
}

// RAYMARCH

vec3 raymarch(vec3 ro, vec3 rd, float time) {

    float t = 0.0;
    vec3 col = vec3(0.0);
    float acc = 0.0;

    for(int i=0;i<64;i++) {

        vec3 pos = ro + rd * t;
        vec3 animPos = animateGalaxy(pos, time);

        float d = galaxyDensity(animPos, time);

        vec3 c = mix(vec3(0.2,0.1,0.4),
                     vec3(0.8,0.6,1.0), d);

        float alpha = d * 0.08;

        col += c * alpha * (1.0 - acc);
        acc += alpha * (1.0 - acc);

        col += starField(animPos * 10.0, time) * 0.02;

        if(acc > 0.98) break;

        t += 0.05;
    }

    return col;
}

// LENSING

vec2 blackHoleWarp(vec2 uv, vec2 center, float strength) {
    vec2 d = uv - center;
    float r = length(d);
    float warp = strength / (r + 0.05);
    return uv + normalize(d) * warp * 0.02;
}

// ACES

vec3 ACES(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}

// MAIN

void mainImage(out vec4 fragColor, in vec2 fragCoord) {

    vec2 uv = fragCoord / iResolution.xy * 2.0 - 1.0;
    uv.x *= iResolution.x / iResolution.y;

    float time = iTime * 0.2;

    // camera
    vec3 ro = vec3(
        sin(time * 0.2) * 0.5,
        cos(time * 0.15) * 0.3,
        -3.0 + sin(time * 0.1) * 0.2
    );

    uv = blackHoleWarp(uv, vec2(0.0), 0.5);
    vec3 rd = normalize(vec3(uv, 1.5));

    vec3 col = raymarch(ro, rd, time);

    col = ACES(col);
    col = pow(col, vec3(0.4545));

    fragColor = vec4(col, 1.0);
}

// BLACK HOLE (PHYSICALLY-INSPIRED LENSING)

// Bends ray direction based on proximity to black hole
vec3 bendRay(vec3 ro, vec3 rd, vec3 bhPos, float strength) {

    vec3 toBH = bhPos - ro;

    float proj = dot(toBH, rd);
    vec3 closest = ro + rd * proj;

    float dist = length(closest - bhPos);

    // stronger bending when closer
    float bend = strength / (dist * dist + 0.1);

    vec3 dirToBH = normalize(bhPos - closest);

    rd = normalize(rd + dirToBH * bend);

    return rd;
}